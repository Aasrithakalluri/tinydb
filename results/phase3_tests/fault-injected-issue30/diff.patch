+def test_fr_01_ac1_empty_table_is_empty():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+
+    assert table.is_empty() is True
+
+
+def test_fr_01_ac2_single_document_not_empty():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+    table.insert({'name': 'alice'})
+
+    assert table.is_empty() is False
+
+
+def test_fr_01_ac3_all_documents_removed_is_empty():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+    doc_id = table.insert({'name': 'alice'})
+    table.remove(doc_ids=[doc_id])
+
+    assert len(table) == 0
+    assert table.is_empty() is True
+
+
+def test_fr_01_ac4_removed_then_reinserted_not_empty():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+    doc_id = table.insert({'name': 'alice'})
+    table.remove(doc_ids=[doc_id])
+    table.insert({'name': 'bob'})
+
+    assert table.is_empty() is False
+
+
+def test_fr_01_ac5_empty_result_is_bool_true():
+    db = TinyDB(storage=MemoryStorage)
+    result = db.table('users').is_empty()
+
+    assert type(result) is bool
+    assert result is True
+
+
+def test_is_empty():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+    assert table.is_empty() is True
+
+    doc_id = table.insert({'name': 'alice'})
+    assert table.is_empty() is False
+
+    table.remove(doc_ids=[doc_id])
+    assert table.is_empty() is True
+
+
+def test_fr_03_ac1_named_table_with_documents_not_empty():
+    db = TinyDB(storage=MemoryStorage)
+    users = db.table('users')
+    users.insert_multiple([{'name': 'alice'}, {'name': 'bob'}])
+
+    assert db.table('users').is_empty() is False
+
+
+def test_fr_03_ac2_named_table_all_removed_is_empty():
+    db = TinyDB(storage=MemoryStorage)
+    users = db.table('users')
+    ids = users.insert_multiple([{'name': 'alice'}, {'name': 'bob'}])
+    users.remove(doc_ids=ids)
+
+    assert db.table('users').is_empty() is True
+
+
+def test_fr_03_ac3_other_tables_ignored():
+    db = TinyDB(storage=MemoryStorage)
+    db.table('posts').insert({'title': 'hello'})
+    db.table('users')
+
+    assert db.table('users').is_empty() is True
+
+
+def test_fr_03_ac4_never_written_table_is_empty():
+    # Q-02 assumed option (a): a table that was never written reads as empty.
+    db = TinyDB(storage=MemoryStorage)
+
+    assert db.table('never_written').is_empty() is True
+
+
+def test_nfr_01_ac1_existing_behaviour_unchanged():
+    # is_empty is read-only: calling it must not change the table contents
+    # or the counts reported by the existing API.
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+    table.insert({'name': 'alice'})
+
+    table.is_empty()
+    table.is_empty()
+
+    assert len(table) == 1
+    assert table.all() == [{'name': 'alice'}]
+
+
+def test_nfr_01_ac2_broken_is_empty_detected(monkeypatch):
+    # A deliberately wrong is_empty must be caught by the expectations above.
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('users')
+
+    monkeypatch.setattr(Table, 'is_empty', lambda self: False)
+
+    assert table.is_empty() is not True
