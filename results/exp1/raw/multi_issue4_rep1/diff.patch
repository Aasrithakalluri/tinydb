+def test_fr_01_ac1_multiply_matching_document_only(db):
+    db.truncate()
+    db.insert({'price': 10, 'category': 'books'})
+    db.insert({'price': 5, 'category': 'toys'})
+    db.update(multiply('price', 1.1), where('category') == 'books')
+    assert db.get(where('category') == 'books')['price'] == pytest.approx(11.0)
+    assert db.get(where('category') == 'toys')['price'] == 5
+
