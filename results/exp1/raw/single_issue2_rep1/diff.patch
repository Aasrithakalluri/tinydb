+import json
+
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+# Issue #2: documents returned by search() share objects with the query
+# cache. Mutating them changes what later identical searches return.
+# The fix conflicts with the existing test
+# test_query_cache_documents_are_shared_with_cache (CNF-01), so these
+# tests are strict xfail until a human decides which behaviour wins.
+BLOCKED_CNF_01 = pytest.mark.xfail(
+    strict=True,
+    reason='BLOCKED CNF-01: conflicts with '
+           'test_query_cache_documents_are_shared_with_cache',
+)
+
+
+# FR-01: top-level changes to a returned document do not reach later searches
+
+@BLOCKED_CNF_01
+def test_fr_01_ac1_top_level_value_change():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    rows = db.search(query)
+    rows[0]['name'] = 'CHANGED'
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+@BLOCKED_CNF_01
+def test_fr_01_ac2_added_key():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a'})
+    query = where('name') == 'a'
+
+    db.search(query)[0]['extra'] = 1
+
+    assert db.search(query) == [{'name': 'a'}]
+
+
+def test_fr_01_ac3_file_unchanged(tmp_path):
+    path = str(tmp_path / 'db.json')
+    db = TinyDB(path)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    db.search(query)[0]['name'] = 'CHANGED'
+    db.close()
+
+    with open(path) as handle:
+        stored = json.load(handle)
+    assert stored == {'_default': {'1': {'name': 'a', 'tags': ['x']}}}
+
+
+# FR-02: nested changes to a returned document do not reach later searches
+
+@BLOCKED_CNF_01
+def test_fr_02_ac1_nested_list_append():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    db.search(query)[0]['tags'].append('oops')
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+@BLOCKED_CNF_01
+def test_fr_02_ac2_nested_mutation_reaches_storage():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    db.search(query)[0]['tags'].append('oops')
+
+    assert db.all() == [{'name': 'a', 'tags': ['x']}]
+
+
+@BLOCKED_CNF_01
+def test_fr_02_ac3_nested_mutation_on_cache_hit():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+    db.search(query)  # populates the cache
+
+    rows = db.search(query)  # served from the cache
+    rows[0]['tags'].append('oops')
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+# FR-03: the returned list itself is independent of later searches
+
+def test_fr_03_ac1_list_append():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    rows = db.search(query)
+    rows.append({'name': 'fake'})
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+def test_fr_03_ac2_list_clear_on_cache_hit():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+    db.search(query)  # populates the cache
+
+    rows = db.search(query)  # served from the cache
+    rows.clear()
+
+    assert len(db.search(query)) == 1
