diff --git a/tests/test_search_copies.py b/tests/test_search_copies.py
new file mode 100644
index 0000000..45dec57
--- /dev/null
+++ b/tests/test_search_copies.py
@@ -0,0 +1,104 @@
+from tinydb import where
+from tinydb.operations import set as set_field
+
+
+def _setup(db):
+    table = db.table('copies')
+    table.insert({'name': 'a', 'tags': ['x']})
+    return table
+
+
+def test_fr_01_ac1_repeat_search_after_mutation_returns_stored_data(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    first = table.search(query)  # miss: fills the cache
+    assert table.search(query) == [{'name': 'a', 'tags': ['x']}]  # hit
+
+    rows = table.search(query)  # hit
+    rows[0]['name'] = 'CHANGED'
+    rows[0]['tags'].append('oops')
+
+    assert table.search(query) == [{'name': 'a', 'tags': ['x']}]
+    assert first[0]['name'] == 'a'
+
+
+def test_fr_01_ac2_no_match_result_mutation_not_cached(db):
+    table = _setup(db)
+    query = where('name') == 'missing'
+
+    assert table.search(query) == []  # cached as an empty result
+    rows = table.search(query)
+    rows.append({'name': 'fake'})
+
+    assert table.search(query) == []
+
+
+def test_fr_01_ac3_cache_hits_return_independent_objects(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    table.search(query)
+    one = table.search(query)
+    two = table.search(query)
+
+    assert one is not two
+    assert one[0] is not two[0]
+    assert one[0]['tags'] is not two[0]['tags']
+
+
+def test_fr_02_ac1_uncached_result_mutation_does_not_affect_next_search(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    rows = table.search(query)  # first search, not yet cached
+    rows[0]['tags'].append('oops')
+    rows[0]['name'] = 'CHANGED'
+
+    assert table.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+def test_fr_02_ac2_result_mutation_does_not_change_storage(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    rows = table.search(query)
+    rows[0]['tags'].append('oops')
+
+    stored = table._storage.read()['copies']
+    assert list(stored.values()) == [{'name': 'a', 'tags': ['x']}]
+
+
+def test_fr_02_ac3_uncacheable_query_result_mutation_is_isolated(db):
+    table = _setup(db)
+    query = where('name').map(str.upper) == 'A'
+
+    assert not query.is_cacheable()
+    rows = table.search(query)
+    rows[0]['tags'].append('oops')
+
+    assert table.search(query) == [{'name': 'a', 'tags': ['x']}]
+    assert len(table._query_cache) == 0
+
+
+def test_fr_03_ac1_update_after_mutation_shows_updated_stored_value(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    rows = table.search(query)
+    rows[0]['name'] = 'CHANGED'
+    table.update(set_field('name', 'b'), query)
+
+    assert table.search(where('name') == 'b') == [{'name': 'b', 'tags': ['x']}]
+    assert table.search(query) == []
+
+
+def test_fr_03_ac2_remove_after_mutation_returns_empty_result(db):
+    table = _setup(db)
+    query = where('name') == 'a'
+
+    rows = table.search(query)
+    rows[0]['tags'].append('oops')
+    table.remove(query)
+
+    assert table.search(query) == []
