diff --git a/tests/test_tables.py b/tests/test_tables.py
index a94005e..615016b 100644
--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,98 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def test_count_without_condition(db):
+    table = db.table('count_no_cond')
+    table.truncate()
+
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.insert({})
+
+    assert table.count() == 3
+
+
+def test_count_none_condition(db):
+    table = db.table('count_none_cond')
+    table.truncate()
+
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.insert({})
+
+    assert table.count(None) == 3
+
+
+def test_fr_01_ac1_count_includes_doc_without_id(db):
+    table = db.table('fr_01_ac1')
+    table.truncate()
+
+    table.insert({'x': 1})
+    table.insert({'x': 2})
+    table.insert({'no_id_field': True})
+
+    assert table.count() == 3
+
+
+def test_fr_01_ac2_count_empty_table(db):
+    table = db.table('fr_01_ac2')
+    table.truncate()
+
+    assert table.count() == 0
+
+
+def test_fr_01_ac3_count_after_remove(db):
+    table = db.table('fr_01_ac3')
+    table.truncate()
+
+    doc_id = table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.remove(doc_ids=[doc_id])
+
+    assert table.count() == 1
+
+
+def test_fr_01_ac4_count_ignores_filter(db):
+    table = db.table('fr_01_ac4')
+    table.truncate()
+
+    table.insert({'x': 2})
+
+    assert table.count() == 1
+    assert table.count(where('x') == 1) == 0
+    assert table.count() == 1
+
+
+def test_fr_02_ac1_count_condition_matches(db):
+    table = db.table('fr_02_ac1')
+    table.truncate()
+
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.insert({})
+
+    assert table.count(where('a') == 1) == 1
+
+
+def test_fr_02_ac2_count_condition_matches_nothing(db):
+    table = db.table('fr_02_ac2')
+    table.truncate()
+
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.insert({})
+
+    assert table.count(where('a') == 9) == 0
+
+
+def test_fr_02_ac3_count_condition_exists(db):
+    table = db.table('fr_02_ac3')
+    table.truncate()
+
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    table.insert({})
+
+    assert table.count(where('a').exists()) == 2
