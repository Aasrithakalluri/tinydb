diff --git a/tests/test_tables.py b/tests/test_tables.py
index a94005e..d46558a 100644
--- a/tests/test_tables.py
+++ b/tests/test_tables.py
@@ -197,3 +197,137 @@ def test_persist_empty_does_not_wipe_existing_data(tmpdir):
     assert len(table) == 1
     assert table.all() == [{'a': 1}]
     db.close()
+
+
+def _search_isolation_db(tmp_path):
+    from tinydb import TinyDB
+
+    db = TinyDB(tmp_path / 'db.json')
+    db.truncate()
+    db.insert({'name': 'a', 'tags': ['x']})
+    return db
+
+
+def test_search_results_isolated_from_caller_mutation(tmp_path):
+    """Mutating a search() result must not change the cache or the table."""
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['name'] = 'CHANGED'
+    rows[0]['tags'].append('oops')
+
+    assert db.search(q) == [{'name': 'a', 'tags': ['x']}]
+    db.close()
+
+
+def test_search_cache_isolated_nested_values(tmp_path):
+    """Nested values from a cached search() result must not leak back."""
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    first = db.search(q)
+    first[0]['tags'].append('leak')
+    second = db.search(q)
+    second[0]['tags'].append('leak2')
+
+    assert db.search(q) == [{'name': 'a', 'tags': ['x']}]
+    db.close()
+
+
+def test_fr_01_ac1_mutate_fields_and_nested_list(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['name'] = 'CHANGED'
+    rows[0]['tags'].append('oops')
+
+    assert db.search(q) == [{'name': 'a', 'tags': ['x']}]
+    db.close()
+
+
+def test_fr_01_ac2_add_and_delete_keys(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['new_key'] = 1
+    del rows[0]['name']
+
+    result = db.search(q)
+    assert result == [{'name': 'a', 'tags': ['x']}]
+    assert 'new_key' not in result[0]
+    assert 'name' in result[0]
+    db.close()
+
+
+def test_fr_01_ac3_append_to_result_list(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows.append({'name': 'a', 'tags': []})
+
+    result = db.search(q)
+    assert isinstance(result, list)
+    assert len(result) == 1
+    assert result[0] == {'name': 'a', 'tags': ['x']}
+    db.close()
+
+
+def test_fr_01_ac4_stored_values_survive_mutation_and_reopen(tmp_path):
+    from tinydb import TinyDB
+
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['name'] = 'CHANGED'
+    rows[0]['tags'].append('oops')
+
+    assert db.all() == [{'name': 'a', 'tags': ['x']}]
+    db.close()
+
+    reopened = TinyDB(tmp_path / 'db.json')
+    assert reopened.search(q) == [{'name': 'a', 'tags': ['x']}]
+    reopened.close()
+
+
+def test_fr_01_ac5_append_to_empty_result(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'zzz'
+
+    rows = db.search(q)
+    assert rows == []
+    rows.append({})
+
+    assert db.search(q) == []
+    db.close()
+
+
+def test_fr_02_ac1_all_unchanged_after_search_mutation(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['name'] = 'CHANGED'
+
+    stored = db.all()
+    assert stored == [{'name': 'a', 'tags': ['x']}]
+    assert all('CHANGED' not in doc.values() for doc in stored)
+    db.close()
+
+
+def test_fr_02_ac2_get_by_id_unchanged_after_search_mutation(tmp_path):
+    db = _search_isolation_db(tmp_path)
+    q = where('name') == 'a'
+
+    rows = db.search(q)
+    rows[0]['name'] = 'CHANGED'
+
+    doc_id = db.all()[0].doc_id
+    doc = db.get(doc_id=doc_id)
+    assert doc is not None
+    assert doc['name'] == 'a'
+    db.close()
