+    def _read_table_sorted(self) -> list[tuple[str, Mapping]]:
+        """
+        Return the raw (doc_id, document) pairs of the table sorted by ID.
+
+        The stored order depends on the history of the table (explicit IDs
+        are appended, and storages may reorder keys), so results are sorted
+        by the document ID to keep their order predictable.
+        """
+
+        return sorted(
+            self._read_table().items(),
+            key=lambda item: self.document_id_class(item[0])
+        )
