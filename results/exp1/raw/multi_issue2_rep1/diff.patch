+def test_search_miss_result_mutation_is_isolated():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    # First call is a cache miss
+    result = db.search(query)
+    result[0]['name'] = 'CHANGED'
+    result[0]['tags'].append('oops')
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
+
+def test_search_hit_result_mutation_is_isolated():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    db.search(query)  # populate the cache
+    result = db.search(query)  # cache hit
+    result[0]['tags'].append('oops')
+
+    assert db.search(query) == [{'name': 'a', 'tags': ['x']}]
+
