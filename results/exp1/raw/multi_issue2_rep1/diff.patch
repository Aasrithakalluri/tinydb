+    db.insert({'name': 'a', 'tags': ['x']})
+    query_no_match = where('name') == 'zzz'
+
+    before_all = db.all()
+    with open(path) as f:
+        before_count = len(json.load(f)['_default'])
+
+    r = db.search(query_no_match)
+    r.append({'name': 'b'})
+
+    assert db.all() == before_all
