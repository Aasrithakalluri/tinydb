+def test_fr_02_ac3_hit_mutation_then_insert_returns_stored_values(tmp_path):
+    db = TinyDB(str(tmp_path / 'db.json'))
+    db.insert({'name': 'a', 'tags': ['x']})
+    query = where('name') == 'a'
+
+    r1 = db.search(query)  # miss
+    r1[0]['name'] = 'CHANGED'
+    r2 = db.search(query)  # hit
+    r2[0]['tags'].append('oops')
+
+    db.insert({'name': 'a', 'tags': ['y']})
+    result = db.search(query)
+
+    assert result == [{'name': 'a', 'tags': ['x']}, {'name': 'a', 'tags': ['y']}]
