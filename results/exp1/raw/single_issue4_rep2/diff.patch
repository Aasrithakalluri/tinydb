+
+
+def _price_db(price):
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'category': 'books', 'price': price})
+    return db
+
+
+def test_fr_01_ac1_multiply_float_factor():
+    db = _price_db(10)
+    db.update(multiply('price', 1.1), where('category') == 'books')
+    assert db.get(where('category') == 'books')['price'] == pytest.approx(11.0)
+
+
+def test_fr_01_ac2_factor_zero_and_one_boundary():
+    db = _price_db(7)
+    db.update(multiply('price', 1), where('category') == 'books')
+    assert db.get(where('category') == 'books')['price'] == 7
+
+    db.update(multiply('price', 0), where('category') == 'books')
+    assert db.get(where('category') == 'books')['price'] == 0
+
+
+def test_fr_01_ac3_non_numeric_field_raises_and_keeps_value():
+    db = _price_db('ten')
+    with pytest.raises(TypeError):
+        db.update(multiply('price', 1.5), where('category') == 'books')
+    assert db.get(where('category') == 'books')['price'] == 'ten'
+
+
+def test_fr_01_ac4_missing_field_raises_and_keeps_document():
+    db = _price_db(10)
+    with pytest.raises(KeyError):
+        db.update(multiply('cost', 2), where('category') == 'books')
+    assert db.get(where('category') == 'books') == {'category': 'books', 'price': 10}
