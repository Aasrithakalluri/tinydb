+def test_fr_03_ac1_default_reopen_keeps_order(tmp_path):
+    path = tmp_path / 'reopen.json'
+    db = TinyDB(path)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+    recorded = [doc.doc_id for doc in db.all()]
+    db.close()
+
+    db = TinyDB(path)
+    assert [doc.doc_id for doc in db.all()] == recorded == list(range(1, 13))
+    db.close()
+
+
+def test_fr_03_ac2_sort_keys_reopen_keeps_order(tmp_path):
+    path = tmp_path / 'sorted.json'
+    db = TinyDB(path, sort_keys=True)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+    recorded = [doc.doc_id for doc in db.all()]
+    db.close()
+
+    db = TinyDB(path, sort_keys=True)
+    assert [doc.doc_id for doc in db.all()] == recorded == list(range(1, 13))
+    db.close()
+
+
+def test_fr_03_ac3_update_and_remove_then_reopen(tmp_path):
+    path = tmp_path / 'mixed.json'
+    db = TinyDB(path)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+    db.update({'v': 99}, doc_ids=[5])
+    db.remove(doc_ids=[7])
+    db.close()
+
+    db = TinyDB(path)
+    expected = [i for i in range(1, 13) if i != 7]
+    assert [doc.doc_id for doc in db.all()] == expected
+    db.close()
