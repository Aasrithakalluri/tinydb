+def test_fr_01_ac1_fresh_database_order(tmp_path):
+    db = TinyDB(tmp_path / 'fresh.json')
+    db.insert_multiple({'v': i} for i in range(1, 4))
+
+    assert [doc.doc_id for doc in db.all()] == [1, 2, 3]
+    db.close()
+
+
+def test_fr_01_ac2_twelve_docs_numeric_not_text_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+
+    assert [doc.doc_id for doc in db.all()] == list(range(1, 13))
+
+
+def test_fr_01_ac3_search_keeps_numeric_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+
+    result = db.search(where('v') >= 2)
+    assert [doc.doc_id for doc in result] == list(range(2, 13))
+
+
+def test_fr_01_ac4_empty_table_returns_empty_lists():
+    db = TinyDB(storage=MemoryStorage)
+
+    assert db.all() == []
+    assert db.search(where('v') == 1) == []
+
+
+def test_fr_02_ac1_update_by_id_keeps_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 4))
+
+    db.update({'v': 9}, doc_ids=[1])
+
+    assert [doc.doc_id for doc in db.all()] == [1, 2, 3]
+    assert db.get(doc_id=1)['v'] == 9
+
+
+def test_fr_02_ac2_update_no_match_keeps_order():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 4))
+    before = [doc.doc_id for doc in db.all()]
+
+    db.update({'v': 9}, where('v') == 'missing')
+
+    assert [doc.doc_id for doc in db.all()] == before
+
+
+def test_fr_02_ac3_remove_then_insert_appends_last():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 4))
+
+    db.remove(doc_ids=[2])
+    new_id = db.insert({'v': 4})
+
+    assert new_id == 4
+    assert [doc.doc_id for doc in db.all()] == [1, 3, 4]
+    assert db.all()[-1].doc_id == new_id
+
+
+def test_fr_02_ac4_remove_all_then_insert():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple({'v': i} for i in range(1, 4))
+
+    db.remove(doc_ids=[1, 2, 3])
+    assert db.all() == []
+
+    new_id = db.insert({'v': 'new'})
+    assert new_id > 0
+    assert [doc.doc_id for doc in db.all()] == [new_id]
