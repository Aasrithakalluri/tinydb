+    def _sorted_doc_items(self) -> list[tuple[str, Mapping]]:
+        """
+        Return the raw ``(doc_id, document)`` pairs of this table, sorted by
+        numeric document ID.
+
+        Storages such as ``JSONStorage`` write keys with ``sort_keys=True``,
+        so a reopened table may list its IDs in string order (1, 10, 11, 2).
+        Sorting here keeps the order consistent across iteration and search.
+        Keys that cannot be converted to ``document_id_class`` fall back to
+        their raw value.
+        """
+
+        def sort_key(item: tuple[str, Mapping]):
+            try:
+                return (0, self.document_id_class(item[0]), '')
+            except (TypeError, ValueError):
+                return (1, 0, str(item[0]))
+
+        return sorted(self._read_table().items(), key=sort_key)
