+def _doc_ids(docs):
+    return [doc.doc_id for doc in docs]
+
+
+def test_fr_03_ac1_json_reopen_default_order(tmpdir):
+    from tinydb import TinyDB
+
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+    db.close()
+
+    db = TinyDB(path)
+    assert _doc_ids(db.all()) == list(range(1, 13))
+    assert _doc_ids(db.search(where('v') >= 2)) == list(range(2, 13))
+    db.close()
+
+
+def test_fr_03_ac2_json_reopen_sort_keys_order(tmpdir):
+    from tinydb import TinyDB
+
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path, storage=JSONStorage, sort_keys=True)
+    db.insert_multiple({'v': i} for i in range(1, 13))
+    db.close()
+
+    db = TinyDB(path, storage=JSONStorage, sort_keys=True)
+    ids = _doc_ids(db.all())
+    assert ids == list(range(1, 13))
+    assert ids != [1, 10, 11, 12, 2, 3, 4, 5, 6, 7, 8, 9]
+    db.close()
+
+
+def test_fr_03_ac3_json_empty_file_all(tmpdir):
+    from tinydb import TinyDB
+
+    path = str(tmpdir.join('test.db'))
+    touch(path, create_dirs=False)
+
+    db = TinyDB(path)
+    assert db.all() == []
+    db.close()
+
+
+def test_fr_03_ac4_json_reopen_after_update_and_remove(tmpdir):
+    from tinydb import TinyDB
+
+    path = str(tmpdir.join('test.db'))
+    db = TinyDB(path)
+    db.insert_multiple({'v': i} for i in range(1, 6))
+    db.update({'tag': 'x'}, doc_ids=[2])
+    db.remove(doc_ids=[3])
+    before = _doc_ids(db.all())
+    db.close()
+
+    db = TinyDB(path)
+    assert _doc_ids(db.all()) == before
+    db.close()
