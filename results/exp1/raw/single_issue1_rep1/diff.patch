+def test_fr_01_ac1_missing_field():
+    query = where('nickname') != 'bob'
+    assert query({'name': 'c'})
+    assert query({'name': 'b', 'nickname': 'al'})
+    assert not query({'name': 'a', 'nickname': 'bob'})
+    assert (~(where('nickname') == 'bob'))({'name': 'c'})
+
+
+def test_fr_01_ac2_equal_value():
+    query = where('nickname') != 'bob'
+    assert not query({'nickname': 'bob'})
+    assert not query({'nickname': 'bob', 'name': 'a'})
+    assert query({'nickname': None})
+
+
+def test_fr_02_ac1_nested_missing_parent():
+    query = where('profile')['age'] != 30
+    assert query({'name': 'x'})
+    assert query({'profile': 'not-a-dict'})
+    assert query({'profile': {'name': 'x'}})
+    assert not query({'profile': {'age': 30}})
+    assert query({'profile': {'age': 31}})
+
+
 def test_lt():
     query = Query().value < 1
