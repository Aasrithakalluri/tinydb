+def test_fr_01_ac1_multiply_float_factor_matching_only(db):
+    db.drop_tables()
+    db.insert({'category': 'books', 'price': 10})
+    db.insert({'category': 'toys', 'price': 10})
+
+    db.update(multiply('price', 1.1), where('category') == 'books')
+
+    assert db.get(where('category') == 'books')['price'] == pytest.approx(11.0)
+    assert db.get(where('category') == 'toys')['price'] == 10
+
+
+def test_fr_01_ac2_multiply_int_factor(db):
+    db.drop_tables()
+    db.insert({'name': 'p', 'price': 5})
+
+    db.update(multiply('price', 2), where('name') == 'p')
+
+    assert db.get(where('name') == 'p')['price'] == 10
+
+
+def test_fr_01_ac3_multiply_identity_factor(db):
+    db.drop_tables()
+    db.insert({'name': 'p', 'price': 7})
+
+    db.update(multiply('price', 1), where('name') == 'p')
+
+    assert db.get(where('name') == 'p')['price'] == 7
+
+
+def test_fr_01_ac4_multiply_empty_match(db):
+    db.drop_tables()
+    db.insert({'category': 'books', 'price': 10})
+    before = db.all()
+
+    db.update(multiply('price', 1.1), where('category') == 'none')
+
+    assert db.all() == before
