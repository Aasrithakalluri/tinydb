+def test_fr_02_ac1_multiply_missing_field(db):
+    db.drop_tables()
+    db.insert({'name': 'x'})
+
+    with pytest.raises(KeyError):
+        db.update(multiply('price', 1.1), where('name') == 'x')
+
+    assert db.get(where('name') == 'x') == {'name': 'x'}
+
+
+def test_fr_02_ac2_multiply_zero_value(db):
+    db.drop_tables()
+    db.insert({'name': 'z', 'price': 0})
+
+    db.update(multiply('price', 1.1), where('name') == 'z')
+
+    assert db.get(where('name') == 'z')['price'] == 0
+
+
+def test_fr_03_ac1_multiply_non_numeric_str(db):
+    db.drop_tables()
+    db.insert({'name': 't', 'price': 'ten'})
+
+    with pytest.raises(TypeError):
+        db.update(multiply('price', 1.1), where('name') == 't')
+
+    assert db.get(where('name') == 't')['price'] == 'ten'
+
+
+def test_fr_03_ac2_multiply_none_value(db):
+    db.drop_tables()
+    db.insert({'name': 'n', 'price': None})
+
+    with pytest.raises(TypeError):
+        db.update(multiply('price', 2), where('name') == 'n')
+
+    assert db.get(where('name') == 'n')['price'] is None
