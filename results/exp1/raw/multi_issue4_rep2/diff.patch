+def multiply(field: str, factor: Union[int, float]) -> Callable[[MutableMapping], None]:
+    """
+    Multiply a given field in the document by ``factor``.
+    """
+    def transform(doc: MutableMapping):
+        doc[field] *= factor
+
+    return transform
